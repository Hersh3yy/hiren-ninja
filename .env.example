# Hygraph (GraphQL CMS) credentials.
# Copy this file to .env and fill in the real values. The .env file is gitignored.
HYGRAPH_ENDPOINT=https://your-region.cdn.hygraph.com/content/your-project-id/master
HYGRAPH_TOKEN=your-hygraph-permanent-auth-token

# ClickUp (lead capture from contact / service forms).
# Create a personal API token in ClickUp Settings → Apps, then use your target list ID.
CLICKUP_API_KEY=your-clickup-personal-api-token
CLICKUP_LIST_ID=your-clickup-list-id
