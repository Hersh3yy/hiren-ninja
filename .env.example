# ClickUp (lead capture from contact / service forms).
# Create a personal API token in ClickUp Settings → Apps, then use your target list ID.
CLICKUP_API_KEY=your-clickup-personal-api-token
CLICKUP_LIST_ID=your-clickup-list-id

# VAMS (koala/VAMS) read API: projects and ADE Planner data.
# Without these, projects come from server/assets/projects-snapshot.json and ADE Planner from
# server/assets/ade-planner/snapshot.json.
VAMS_API_URL=https://your-vams-host/api
VAMS_API_KEY=your-64-char-vams-api-key
